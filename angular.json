{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "number-catch": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "nc",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": { "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"] }
        },
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/number-catch",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              {
                "glob": "maplibre-gl-worker.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/"
              },
              {
                "glob": "maplibre-gl-shared.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/"
              }
            ],
            "styles": [
              "node_modules/@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.css",
              "node_modules/maplibre-gl/dist/maplibre-gl.css"
            ],
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "2.5mb", "maximumError": "3mb" }],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                }
              ],
              "styles": [
                "node_modules/@angular/material/prebuilt-themes/azure-blue.css",
                "src/styles.css",
                "node_modules/maplibre-gl/dist/maplibre-gl.css"
              ],
              "polyfills": ["zone.js", "zone.js/testing"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "number-catch:build:production" },
            "development": { "buildTarget": "number-catch:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
